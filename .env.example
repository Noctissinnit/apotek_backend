APP_NAME="Apotek API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Kosongkan saat development. Isi di production supaya endpoint tulis
# (POST/PUT/PATCH/DELETE) wajib mengirim header X-API-KEY.
API_KEY=
API_RATE_LIMIT=60

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------- Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apotek_db
DB_USERNAME=root
DB_PASSWORD=

# Wajib untuk MySQL cloud yang memaksa TLS (Aiven, TiDB Cloud, PlanetScale).
# Isi dengan path file CA, contoh di Vercel: /var/task/storage/certs/ca.pem
# MYSQL_ATTR_SSL_CA=

# Serverless tidak punya penyimpanan persisten -> pakai driver yang stateless.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
