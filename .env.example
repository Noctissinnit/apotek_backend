APP_NAME="Apotek"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Identitas apotek, tampil di judul halaman dan kop struk.
APOTEK_NAMA="Apotek Sehat"
APOTEK_ALAMAT="Jl. Contoh No. 1"
APOTEK_TELEPON=-

# Batas percobaan login per menit (per email + IP).
LOGIN_RATE_LIMIT=5

# Password awal akun contoh dari seeder. WAJIB diganti di production.
SEED_ADMIN_PASSWORD=
SEED_KASIR_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---------------------------------------------------------------- Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apotek_db
DB_USERNAME=root
DB_PASSWORD=

# Wajib untuk MySQL cloud yang memaksa TLS (Aiven, TiDB Cloud).
# Isi dengan path file CA. Di Vercel root proyek ada di /var/task/user, jadi
# file certs/ca.pem di repo menjadi: /var/task/user/certs/ca.pem
# MYSQL_ATTR_SSL_CA=

# Session login & cache disimpan di database (tabel sessions & cache dibuat
# oleh migrasi), jadi tetap jalan di XAMPP, LAN, maupun Vercel.
SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=database
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
